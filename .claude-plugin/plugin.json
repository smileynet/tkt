{
  "name": "tkt",
  "displayName": "tkt",
  "version": "0.4.0",
  "description": "Git-native ticket tracker and workflow skills (tkt-core, tkt-orient, tkt-work, tkt-reconcile): track tasks as markdown files in .tickets/ and work the dependency-graph frontier. Requires the tkt CLI on PATH.",
  "author": {
    "name": "smileynet"
  },
  "homepage": "https://github.com/smileynet/tkt",
  "repository": "https://github.com/smileynet/tkt",
  "license": "MIT",
  "hooks": "./.claude-plugin/claude-hooks.json",
  "keywords": [
    "tickets",
    "task-management",
    "dependencies",
    "frontier",
    "tkt"
  ],
  "metadata": {
    "deploy": {
      "claudeFiles": [
        ".claude-plugin/claude-hooks.json",
        ".claude-plugin/hooks/session-start.mjs"
      ],
      "forbidRefs": [
        "frontier-work",
        "read-handoff",
        "to-tickets",
        "spec-driven-development",
        "reconcile-tickets",
        "wrap-session",
        "compass",
        "implement-spec"
      ],
      "legalFiles": [
        "LICENSE",
        "NOTICE",
        "tools/LICENSE-grey-matter.txt"
      ],
      "skillLicenseFiles": [
        "LICENSE"
      ],
      "runtimeFiles": [
        "tools/release.mjs",
        "tools/release-artifacts.mjs",
        "tools/release-version.mjs",
        "tools/release-git.mjs",
        "tools/release-product.mjs",
        "tools/release-native.mjs",
        "tools/check-skill-syntax.mjs",
        "tools/probe-claude-validation.mjs",
        "tools/deploy.mjs",
        "package.json",
        "package-lock.json",
        "tools/release-verify.mjs",
        "tools/release-publish.mjs",
        "tools/release-github.mjs",
        "tools/release-staging.mjs",
        "tools/release-publication.mjs",
        "tools/release-registry.mjs",
        "tools/release-development.mjs",
        "tools/release-ci-artifacts.mjs",
        "tools/release-tkt-publication.mjs"
      ]
    }
  }
}
